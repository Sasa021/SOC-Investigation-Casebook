// Portfolio query: detect repeated sign-in failures followed by success.
// Tune thresholds and exclusions against the organisation's baseline.
let Lookback = 24h;
let FailureThreshold = 5;
let SuccessWindow = 30m;
let FailedSignIns = materialize(
    SigninLogs
    | where TimeGenerated >= ago(Lookback)
    | where ResultType != 0
    | summarize
        FailedAttempts = count(),
        FirstFailure = min(TimeGenerated),
        LastFailure = max(TimeGenerated),
        FailureResultTypes = make_set(tostring(ResultType), 10),
        FailureApplications = make_set(AppDisplayName, 10)
      by UserPrincipalName, IPAddress
    | where FailedAttempts >= FailureThreshold
);
let SuccessfulSignIns =
    SigninLogs
    | where TimeGenerated >= ago(Lookback)
    | where ResultType == 0
    | project
        UserPrincipalName,
        IPAddress,
        SuccessTime = TimeGenerated,
        SuccessApplication = AppDisplayName,
        Location = tostring(LocationDetails),
        Device = tostring(DeviceDetail);
FailedSignIns
| join kind=inner SuccessfulSignIns on UserPrincipalName, IPAddress
| where SuccessTime between (LastFailure .. (LastFailure + SuccessWindow))
| extend MinutesFromLastFailure = datetime_diff("minute", SuccessTime, LastFailure)
| project
    UserPrincipalName,
    IPAddress,
    FailedAttempts,
    FirstFailure,
    LastFailure,
    SuccessTime,
    MinutesFromLastFailure,
    FailureResultTypes,
    FailureApplications,
    SuccessApplication,
    Location,
    Device
| order by FailedAttempts desc, SuccessTime desc
